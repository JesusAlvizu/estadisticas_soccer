# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=estadisticas_db
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys (Sportdata APIs)
API_KEY_FOOTBALL=your-api-key-here
API_KEY_SPORTS=your-api-key-here
API_KEY_RAPIDAPI=your-api-key-here
SPORTMONKS_API_KEY=your-sportmonks-key-here
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_LEAGUE_ID=262
SPORTMONKS_DAILY_LIMIT=250
SPORTMONKS_QUOTA_FILE=/tmp/sportmonks_quota.json
SPORTMONKS_RATE_LIMIT_FILE=/tmp/sportmonks_rate_limit.json
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_QUOTA_FILE=/tmp/api_football_quota.json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASEURL=http://backend:8000

# PgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Application Settings
MAX_SIMULATIONS=10000
MODELS_RETRAIN_FREQUENCY=daily
ODDS_UPDATE_FREQUENCY=hourly

# Liga MX Focus
LIGA_MX_SYNC_ENABLED=true
LIGA_MX_LEAGUE_ID=262
LIGA_MX_SEASON=2026
LIGA_MX_TOURNAMENT_START=2026-07-01
LIGA_MX_TOURNAMENT_END=2026-12-31

# Sync Cadence (minutes)
SYNC_TEAMS_MINUTES=720
SYNC_PLAYERS_MINUTES=360
SYNC_MATCHES_MINUTES=15
SYNC_STATISTICS_MINUTES=15
SYNC_ODDS_MINUTES=5
GENERATE_PREDICTIONS_MINUTES=5
DAILY_SYNC_HOUR_UTC=3
DAILY_SYNC_MINUTE_UTC=0
DAILY_PREDICTIONS_HOUR_UTC=4
DAILY_PREDICTIONS_MINUTE_UTC=0
HISTORICAL_SEASONS_COUNT=10
